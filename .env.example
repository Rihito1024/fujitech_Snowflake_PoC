# Snowflake 接続情報のテンプレート。
# コピーして .env を作成し、値を埋める（.env は Git 管理外）:
#   cp .env.example .env
#
# 適用:
#   set -a; source .env; set +a
#   snow sql -c fujitech -q "select current_account()"

SNOWFLAKE_CONNECTIONS_FUJITECH_ACCOUNT=<org>-<account>   # 例: SSKMHJJ-VF99886
SNOWFLAKE_CONNECTIONS_FUJITECH_USER=<ユーザー名>
SNOWFLAKE_CONNECTIONS_FUJITECH_PASSWORD=<パスワード>
SNOWFLAKE_CONNECTIONS_FUJITECH_ROLE=ACCOUNTADMIN         # セットアップ実行ロール
SNOWFLAKE_CONNECTIONS_FUJITECH_WAREHOUSE=SALES_WH        # 01_roles_and_warehouse.sql 実行後に有効

DBT_SNOWFLAKE_USER=<ユーザー名>
DBT_SNOWFLAKE_PASSWORD=<パスワード>
